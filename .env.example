# Environment Variables Example
# Copy this file to .env and fill in your values

# Supabase Configuration (used by both frontend and API routes)
# Must have VITE_ prefix for Vite to expose it to the frontend
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: For backward compatibility (will be removed in future)
DB_URL=
API_KEY=